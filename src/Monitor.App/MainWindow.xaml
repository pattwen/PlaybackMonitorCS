<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Monitor.App" x:Class="Monitor.App.MainWindow" Title="MultiPlay · Version 0.5.0-Beta" Style="{StaticResource {x:Type Window}}" Width="1440" Height="980" MinWidth="1050" MinHeight="720" PreviewKeyDown="OnKey" Closing="OnClosing">
    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MultiPlay" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="   Produced by Chloe Skywalker" Foreground="#8FA4B8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="StateText" Text="就绪" Foreground="#61D9B1" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- 核心文件与流操作类：统一使用品牌主色（深青色/墨绿色） -->
            <Button Content="打开视频" Click="OpenFile" Background="#0F665C" Foreground="White"/>
            <Button Content="打开链接" Click="OpenStreamUrl" Background="#0F665C" Foreground="White"/>
            <Button Content="播放列表" Click="Sources" Background="#0F665C" Foreground="White"/>
            <!-- 常规查看与辅助工具类：使用沉稳的Slate蓝灰色 -->
            <Button Content="媒体信息" Click="AnalyzeMedia" Background="#475569" Foreground="White"/>
            <Button Content="播放截图" Click="Screenshot" Background="#475569" Foreground="White"/>
            <Button Content="记录目录" Click="Records" Background="#475569" Foreground="White"/>
            <!-- 配置与设置类 -->
            <Button Content="检测设置" Click="Settings" Background="#334155" Foreground="White"/>
            <Button Content="提示音设置" Click="SoundSettings" Background="#334155" Foreground="White"/>
            <!-- 业务和标记类 -->
            <Button Content="人工标记" Click="Mark" Background="#D97706" Foreground="White"/>
            <!-- 状态和异常类（只有Enable时候才边红） -->
            <Button x:Name="ErrorDetailsButton" Content="错误详情" Click="ShowErrorDetails" IsEnabled="False" Background="#DC2626" Foreground="White"/>
            <!-- 告警开关 -->
            <CheckBox x:Name="BeepCheck" Content="告警提示音" Checked="SaveOptions" Unchecked="SaveOptions"/>
        </WrapPanel>
        <TextBlock Grid.Row="2" x:Name="SourceText" Text="选择文件或配置网络媒体地址" Foreground="#8FA4B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Background="Black" Margin="0,0,10,0">
                <local:VideoHost x:Name="Video"/>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" CornerRadius="7" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="实时监看状态" FontWeight="Bold"/>
                        <TextBlock x:Name="AlarmText" Text="等待播放" Foreground="#61D9B1" TextWrapping="Wrap" Margin="0,10"/>
                        <TextBlock Text="源音频 / 每声道 RMS 与峰值" Foreground="#8FA4B8"/>
                        <WrapPanel x:Name="Meters" Margin="0,8"/>
                        <TextBlock Text="播放节目（Program）"/>
                        <ComboBox x:Name="ProgramBox" DisplayMemberPath="Label" SelectionChanged="ProgramChanged" Margin="0,0,0,6" ToolTip="选择节目后自动切换对应的视频与音轨。">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="IsEnabled" Value="{Binding HasVideo}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Text="监听音轨"/>
                        <ComboBox x:Name="AudioTrackBox" DisplayMemberPath="Label" SelectionChanged="AudioTrackChanged"/>
                        <TextBlock Text="监听声道（不改变检测）"/>
                        <ComboBox x:Name="SoloBox" SelectionChanged="SoloChanged">
                            <ComboBoxItem Content="全部声道下混"/>
                        </ComboBox>
                        <Expander Header="媒体信息 / 实际播放状态">
                            <StackPanel>
                                <TextBlock x:Name="RuntimeInfo" TextWrapping="Wrap" Foreground="#A9BACB"/>
                                <TextBlock x:Name="RuntimeStatsText" TextWrapping="Wrap" Foreground="#8FA4B8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="显示与去交错">
                            <StackPanel>
                                <TextBlock Text="显示策略"/>
                                <ComboBox x:Name="DisplayBox" SelectionChanged="DisplayChanged">
                                    <ComboBoxItem Content="原生显示（HDR不自动映射）"/>
                                    <ComboBoxItem Content="SDR兼容预览（明确映射）"/>
                                </ComboBox>
                                <TextBlock Text="隔行显示"/>
                                <ComboBox x:Name="FieldBox" SelectionChanged="DisplayChanged">
                                    <ComboBoxItem Content="自动去隔行（推荐）"/>
                                    <ComboBoxItem Content="保留原始隔行"/>
                                    <ComboBoxItem Content="仅看高场"/>
                                    <ComboBoxItem Content="仅看低场"/>
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="告警事件建议人工复核。直播无缓存；文件可定位回放。" Foreground="#8FA4B8" TextWrapping="Wrap" Margin="0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,8,0,3">
            <AdornerDecorator>
                <local:SeekSlider UserInteractionStarted="TimelineInteractionStarted" UserInteractionCancelled="TimelineInteractionCancelled" SeekRequested="TimelineSeekRequested" x:Name="Timeline" Height="22" Minimum="0" Maximum="10000" ToolTip="红线为本次监看告警起点；文件可拖动定位，直播不可回看"/>
            </AdornerDecorator>
            <DockPanel Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btn_PlayOrStop" Content="播放" Click="Pause"/>
                    <Button Content="停止" Click="Stop"/>
                    <Button x:Name="SeekTimeButton" Content="定位" ToolTip="输入时间定位 · Ctrl+G" Click="GoToTime"/>
                    <TextBlock x:Name="TimeText" Text="00:00:00.000 / —" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="MuteCheck" Content="监听静音" Checked="VolumeChanged" Unchecked="VolumeChanged"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.7" Width="100" ValueChanged="VolumeChanged" VerticalAlignment="Center"/>
                    <Button Content="全屏 F11" Click="FullScreen" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <GridSplitter Grid.Row="5" HorizontalAlignment="Stretch" Background="#304252"/>
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,4,0,8">
                <TextBlock x:Name="CountText" Text="告警记录" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="CurrentOnly" IsChecked="True" Content="仅本次监看" Click="Refresh"/>
                    <Button Content="查看截图" Click="ViewEvidence"/>
                    <Button Content="确认 / 备注" Click="Review"/>
                    <Button Content="导出CSV" Click="Export"/>
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" x:Name="EventsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" MouseDoubleClick="Replay">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="异常" Binding="{Binding Label}"/>
                    <DataGridTextColumn Header="起点" Binding="{Binding StartText}"/>
                    <DataGridTextColumn Header="确认位置" Binding="{Binding ConfirmedText}"/>
                    <DataGridTextColumn Header="结束 / 时长" Binding="{Binding EndText}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}"/>
                    <DataGridTextColumn Header="复核" Binding="{Binding Review}"/>
                    <DataGridTextColumn Header="实际时间" Binding="{Binding WallTime}"/>
                    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock Grid.Row="7" x:Name="BottomText" TextWrapping="NoWrap" MaxHeight="24" Foreground="#8FA4B8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
