<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Monitor.App.App">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#111820"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#19232E"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackground}"/>
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#253545"/>
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="BorderBrush" Value="#3B5268"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E151D"/>
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#35485B"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="#111820"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111820"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#131D27"/>
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="BorderBrush" Value="#35485B"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#131D27"/>
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="RowBackground" Value="#131D27"/>
            <Setter Property="AlternatingRowBackground" Value="#1B2A36"/>
            <Setter Property="BorderBrush" Value="#35485B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#293948"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#223140"/>
            <Setter Property="Foreground" Value="#A9BACB"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#DFE8F2"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Application.Resources>
</Application>
